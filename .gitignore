# Ignore Vivado build artifacts and simulation outputs
# ============================================================
# Vivado / Xilinx project .gitignore
# Keeps: RTL source (.v), constraints (.xdc), hex programs (.hex),
#        testbenches, and the top-level .xpr project file.
# Excludes: all generated build artifacts, caches, and logs.
# ============================================================

# Vivado run/build directories (regenerated by tools every time)
*.runs/
*.sim/
*.cache/
*.hw/
*.ip_user_files/
*.srcs/**/imports/
.Xil/

# Vivado journal, log, and backup files
*.jou
*.log
*.str
*.backup.log
*.stat
vivado*.jou
vivado*.log
vivado_pid*.debug
webtalk*.log
webtalk*.jou

# Vivado generated project metadata (safe to regenerate on clone)
*.xpr.orig
*.gen/
*.cache/
*.hbs
*.hw/

# Checkpoints and generated netlists (large, regenerable)
*.dcp
*.bit
*.bin
*.mcs
*.prm

# Reports (optional -- comment these out if you WANT reports tracked)
# *.rpt
# *.pb

# OS-level junk
Thumbs.db
.DS_Store
desktop.ini

# Editor/IDE junk
*.swp
*~
.vscode/

# Simulation waveform databases (large binary files)
*.wdb
*.wcfg

# Temporary/backup files
*.bak
*.tmp
